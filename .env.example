# --- Обязательные ---
# Токен бота от @BotFather (нужен и боту, и API для проверки initData)
BOT_TOKEN=123456789:AAAA-your-bot-token
# Ключ Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# PostgreSQL (Railway: возьмите DATABASE_URL из сервиса Postgres)
DATABASE_URL=postgresql://user:password@host:5432/railway
# Публичный HTTPS-адрес приложения (Railway: https://<service>.up.railway.app)
WEBAPP_URL=https://your-app.up.railway.app

# --- Доступ ---
# Telegram ID владельцев через запятую (только они получат роль владельца)
OWNER_IDS=111111111
# Telegram ID поваров/закупщиков через запятую. Пусто — эти роли может выбрать любой
STAFF_IDS=

# --- Необязательные ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM=15
# Запускать бота внутри процесса API (true для одного сервиса на Railway)
RUN_BOT_IN_API=true
# Срок жизни initData в секундах
INIT_DATA_TTL=86400
DEFAULT_LANGUAGE=ru
# Каталог со своими шрифтами для PDF (DejaVuSans.ttf, NotoSansSC-Regular.otf)
FONT_DIR=
# Telegram-ник поддержки без @ (кнопка «Поддержка» в приложении). Пусто — кнопка скрыта.
SUPPORT_TELEGRAM=
# Во сколько (час по Ташкенту) бот напоминает повару об остатках готовой еды
REMINDER_HOUR=17
